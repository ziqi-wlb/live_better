page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7f9;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.detail {
  padding: 28rpx 28rpx 80rpx;
}

.d-meta {
  margin-bottom: 12rpx;
}

.muted {
  font-size: 23rpx;
  color: #9aa3b0;
}

.d-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1c2430;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.tag {
  background: #eef3e8;
  color: #477347;
  border-radius: 8rpx;
  font-size: 21rpx;
  padding: 6rpx 16rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-roi {
  background: #e6f7ef;
  color: #0d8a4d;
  font-weight: 600;
}

.tag-cv {
  background: #fdeaea;
  color: #d43a3f;
}

.tag-nv {
  background: #fdf1dd;
  color: #b06e00;
}

.badges {
  display: flex;
  flex-direction: row;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(20, 30, 60, 0.05);
}

.badge-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.badge-label {
  font-size: 22rpx;
  color: #9aa3b0;
  margin-bottom: 10rpx;
}

.badge-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c2430;
}

.section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(20, 30, 60, 0.05);
}

.sec-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #2f6bff;
  margin-bottom: 16rpx;
}

.sec-body {
  font-size: 28rpx;
  color: #3c4552;
  line-height: 1.75;
}

.sec-muted {
  color: #7a8494;
  font-size: 26rpx;
}

.sec-source {
  color: #5a6472;
  font-size: 26rpx;
}

.sec-note {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f2f5;
  font-size: 23rpx;
  color: #9aa3b0;
  line-height: 1.6;
}

.copy-btn {
  margin-top: 18rpx;
  align-self: flex-start;
  background: #eef3e8;
  color: #477347;
  border-radius: 12rpx;
  font-size: 24rpx;
  padding: 14rpx 24rpx;
}

.source-link {
  font-size: 22rpx;
  color: #477347;
  margin-top: 16rpx;
  line-height: 1.5;
}

.actions {
  display: flex;
  flex-direction: row;
  margin-top: 8rpx;
}

.act {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f2f4f7;
  color: #5a6472;
  font-size: 27rpx;
}

.act-on {
  color: #f5a623;
}

.act-picker {
  flex: 1;
  margin-left: 22rpx;
}

.act-primary {
  background: #2f6bff;
  color: #ffffff;
  font-weight: 600;
}

.note-input {
  margin-top: 22rpx;
  background: #f7f8fa;
  border: 1rpx solid #eceef2;
  border-radius: 14rpx;
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
  height: 160rpx;
  font-size: 26rpx;
  color: #3c4552;
}

.save-btn {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 14rpx;
  background: #eef3e8;
  color: #477347;
  font-size: 26rpx;
}

.footnote {
  text-align: center;
  font-size: 22rpx;
  color: #a4acb8;
  padding: 30rpx 20rpx 0;
  line-height: 1.6;
}
