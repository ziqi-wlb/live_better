page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fffdf6;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.detail {
  padding: 28rpx 28rpx 80rpx;
}

.d-meta {
  margin-bottom: 12rpx;
}

.muted {
  font-size: 23rpx;
  color: #a2aaa2;
}

.d-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #23302a;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.tag {
  background: #eef3e8;
  color: #477347;
  border-radius: 8rpx;
  font-size: 21rpx;
  padding: 6rpx 16rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-roi {
  background: #e7eddf;
  color: #214d3f;
  font-weight: 600;
}

.tag-ev {
  background: #faf0d9;
  color: #956e27;
}

.tag-cv {
  background: #fdeaea;
  color: #d43a3f;
}

.tag-nv {
  background: #fdf1dd;
  color: #b06e00;
}

.badges {
  display: flex;
  flex-direction: row;
  background: #ffffff;
  border: 1rpx solid #e3e6db;
  border-radius: 24rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
}

.badge-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.badge-label {
  font-size: 22rpx;
  color: #a2aaa2;
  margin-bottom: 10rpx;
}

.badge-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #23302a;
}

/* 标记说明的入口。紧跟在三个标记下面，用完就算，不占正文注意力 */
.marks-help {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  margin-top: -8rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #f2f6ed;
}

.marks-help text {
  font-size: 24rpx;
  color: #4d6b52;
}

.marks-help-arrow {
  margin-left: 4rpx;
  font-size: 28rpx;
}

.section {
  background: #ffffff;
  border: 1rpx solid #e3e6db;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.sec-title {
  font-size: 28rpx;
  font-weight: 650;
  color: #44745b;
  margin-bottom: 16rpx;
}

.sec-body {
  font-size: 28rpx;
  color: #3a443c;
  line-height: 1.8;
}

.sec-muted {
  color: #727b72;
  font-size: 26rpx;
}

.sec-source {
  color: #5a6560;
  font-size: 26rpx;
}

.sec-note {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eef1e9;
  font-size: 23rpx;
  color: #a2aaa2;
  line-height: 1.6;
}

.source-link {
  font-size: 22rpx;
  color: #477347;
  margin-top: 16rpx;
  line-height: 1.5;
}

.actions {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 8rpx;
}

/* 三块必须严格等宽，但**不能靠 flex:1 分配**：
   1) button 是「受限弹性容器」，会按内容强制加最小宽度，flex-basis:0 被覆盖；
   2) Skyline 下 flex-shrink 默认值还可能是 0，元素根本不会收缩。
   所以直接用固定 31% 宽度（3×31=93%），剩下 7% 由 space-between 分成两段间隙。 */
.actions > .act,
.actions > .act-picker {
  flex: none;
  width: 31%;
  min-width: 0;
  box-sizing: border-box;
}

.act {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  background: #e7eddf;
  color: #214d3f;
  font-size: 27rpx;
}

.act-on {
  color: #c98a1b;
}

/* picker 里面的按钮不是 .actions 的直接子元素，宽度按父级撑满 */
.act-picker .act {
  width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
}

/* button open-type=share 是唯一等价于右上角「转发给朋友」的写法：
   官方规定必须是 button 组件，view 上加 open-type 无效。 */
button.act {
  padding: 0;
  margin: 0;
  width: 31%;
  min-width: 0;
  flex: none;
  line-height: normal;
  font-size: 27rpx;
  border-radius: 16rpx;
}

button.act::after {
  border: none;
}

/* 分享做成次要按钮（描边）。用类显式写，不依赖 button[plain] 属性选择器
   —— Skyline 对 CSS 选择器的支持是子集，不保证支持属性选择器。
   box-sizing: border-box 保证那 1rpx 描边不额外撑宽。 */
.act-share {
  border: 1rpx solid #214d3f;
  background: transparent;
}

.act-primary {
  background: #214d3f;
  color: #ffffff;
  font-weight: 600;
}

.note-input {
  margin-top: 22rpx;
  background: #fbfcf7;
  border: 1rpx solid #e3e6db;
  border-radius: 14rpx;
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
  height: 160rpx;
  font-size: 26rpx;
  color: #3a443c;
}

.save-btn {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 14rpx;
  background: #e7eddf;
  color: #214d3f;
  font-size: 26rpx;
}

/* 原生模板广告：组件默认 width:100%，这里只管外边距，不碰它的样式 */
.ad-wrap {
  margin: 24rpx 0 8rpx;
}

.footnote {
  text-align: center;
  font-size: 22rpx;
  color: #a2aaa2;
  padding: 30rpx 20rpx 0;
  line-height: 1.7;
}

.doc-links {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.doc-link {
  color: #214d3f;
  font-size: 22rpx;
  /* 纵向内边距撑到约 88rpx 的点击区，老人家点得中 */
  padding: 30rpx 10rpx;
}

.doc-link-sep {
  color: #a2aaa2;
  font-size: 22rpx;
  margin: 0 12rpx;
}

/* ===== 等级配色 =====
   性价比 roi：暖色，越值得做越醒目（极高/高/一般）
   证据等级 ev：绿色，越可靠越深（A/B/C）
   标签用背景色区分，数值用字体色区分。 ===== */

/* 标签：背景色 */
.roi-top { background: #c05621; color: #ffffff; }
.roi-high { background: #c98a1b; color: #ffffff; }
.roi-mid { background: #e7eddf; color: #214d3f; }

.ev-a { background: #214d3f; color: #ffffff; }
.ev-b { background: #7d9670; color: #ffffff; }
.ev-c { background: #f1f4ec; color: #8a917d; }

/* 数值：字体色 */
.roi-text-top { color: #c05621; }
.roi-text-high { color: #c98a1b; }
.roi-text-mid { color: #8a917d; }

.ev-text-a { color: #214d3f; }
.ev-text-b { color: #7d9670; }
.ev-text-c { color: #9aa08f; }

/* 收益档：大 / 中 / 小。原来只靠一个汉字区分，扫一眼看不出差别。
   用深浅 + 字重做层次：收益越大颜色越深、字越重。
   色相用偏青蓝的绿——跟「证据等级」那组橄榄绿差 30° 以上，
   否则两栏的「深」撞在一起会看混。
   三档对米白底 #fffdf6 的对比度分别约 8.6 / 5.5 / 4.6，都过 WCAG AA；
   面向家里老人，不取更浅的色。 */
.band-text-big { color: #14525c; font-weight: 600; }
.band-text-mid { color: #35707a; font-weight: 500; }
.band-text-small { color: #547a82; font-weight: 400; }
