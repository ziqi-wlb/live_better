page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fffdf6;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.detail {
  padding: 28rpx 28rpx 80rpx;
}

.d-meta {
  margin-bottom: 12rpx;
}

.muted {
  font-size: 23rpx;
  color: #a2aaa2;
}

.d-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #23302a;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.tag {
  background: #eef3e8;
  color: #477347;
  border-radius: 8rpx;
  font-size: 21rpx;
  padding: 6rpx 16rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-roi {
  background: #e7eddf;
  color: #214d3f;
  font-weight: 600;
}

.tag-ev {
  background: #faf0d9;
  color: #956e27;
}

.tag-cv {
  background: #fdeaea;
  color: #d43a3f;
}

.tag-nv {
  background: #fdf1dd;
  color: #b06e00;
}

.badges {
  display: flex;
  flex-direction: row;
  background: #ffffff;
  border: 1rpx solid #e3e6db;
  border-radius: 24rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
}

.badge-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.badge-label {
  font-size: 22rpx;
  color: #a2aaa2;
  margin-bottom: 10rpx;
}

.badge-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #23302a;
}

.section {
  background: #ffffff;
  border: 1rpx solid #e3e6db;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.sec-title {
  font-size: 28rpx;
  font-weight: 650;
  color: #44745b;
  margin-bottom: 16rpx;
}

.sec-body {
  font-size: 28rpx;
  color: #3a443c;
  line-height: 1.8;
}

.sec-muted {
  color: #727b72;
  font-size: 26rpx;
}

.sec-source {
  color: #5a6560;
  font-size: 26rpx;
}

.sec-note {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eef1e9;
  font-size: 23rpx;
  color: #a2aaa2;
  line-height: 1.6;
}

.copy-btn {
  margin-top: 18rpx;
  align-self: flex-start;
  background: #e7eddf;
  color: #477347;
  border-radius: 14rpx;
  font-size: 24rpx;
  padding: 14rpx 24rpx;
}

.source-link {
  font-size: 22rpx;
  color: #477347;
  margin-top: 16rpx;
  line-height: 1.5;
}

.actions {
  display: flex;
  flex-direction: row;
  margin-top: 8rpx;
}

.act {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  background: #e7eddf;
  color: #214d3f;
  font-size: 27rpx;
}

.act-on {
  color: #c98a1b;
}

.act-picker {
  flex: 1;
  margin-left: 22rpx;
}

.act-share {
  margin-left: 22rpx;
}

.act-primary {
  background: #214d3f;
  color: #ffffff;
  font-weight: 600;
}

.note-input {
  margin-top: 22rpx;
  background: #fbfcf7;
  border: 1rpx solid #e3e6db;
  border-radius: 14rpx;
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
  height: 160rpx;
  font-size: 26rpx;
  color: #3a443c;
}

.save-btn {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 14rpx;
  background: #e7eddf;
  color: #214d3f;
  font-size: 26rpx;
}

.footnote {
  text-align: center;
  font-size: 22rpx;
  color: #a2aaa2;
  padding: 30rpx 20rpx 0;
  line-height: 1.7;
}

.doc-links {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.doc-link {
  color: #214d3f;
  font-size: 22rpx;
  padding: 6rpx 4rpx;
}

.doc-link-sep {
  color: #a2aaa2;
  font-size: 22rpx;
  margin: 0 12rpx;
}

/* ===== 等级配色 =====
   性价比 roi：暖色，越值得做越醒目（极高/高/一般）
   证据等级 ev：绿色，越可靠越深（A/B/C）
   标签用背景色区分，数值用字体色区分。 ===== */

/* 标签：背景色 */
.roi-top { background: #c05621; color: #ffffff; }
.roi-high { background: #c98a1b; color: #ffffff; }
.roi-mid { background: #e7eddf; color: #214d3f; }

.ev-a { background: #214d3f; color: #ffffff; }
.ev-b { background: #7d9670; color: #ffffff; }
.ev-c { background: #f1f4ec; color: #8a917d; }

/* 数值：字体色 */
.roi-text-top { color: #c05621; }
.roi-text-high { color: #c98a1b; }
.roi-text-mid { color: #8a917d; }

.ev-text-a { color: #214d3f; }
.ev-text-b { color: #7d9670; }
.ev-text-c { color: #9aa08f; }
