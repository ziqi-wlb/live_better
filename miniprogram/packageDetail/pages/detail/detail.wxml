<navigation-bar title="{{navTitle}}" back="{{true}}" color="black" background="#FFFDF6" show="{{!navHidden}}"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list" bindscroll="onScroll">
  <view class="detail" wx:if="{{item}}">
    <view class="d-meta">
      <text class="muted">第 {{item.ch}} 节 · 第 {{item.no}} 条</text>
    </view>
    <view class="d-title"><text>{{item.title}}</text></view>

    <view class="tags">
      <text class="tag tag-roi {{item.roi === '极高' ? 'roi-top' : (item.roi === '高' ? 'roi-high' : 'roi-mid')}}">{{item.roi}} 性价比</text>
      <text class="tag tag-ev {{item.ev === 'A' ? 'ev-a' : (item.ev === 'B' ? 'ev-b' : 'ev-c')}}">证据 {{item.ev}}</text>
      <text wx:if="{{item.cv}}" class="tag tag-cv">有争议</text>
      <text wx:if="{{item.nv}}" class="tag tag-nv">待核实</text>
    </view>

    <view class="badges">
      <view class="badge-box">
        <text class="badge-label">收益</text>
        <text class="badge-value band-text-{{item.band === '大' ? 'big' : (item.band === '中' ? 'mid' : 'small')}}">{{item.band}}</text>
      </view>
      <view class="badge-box">
        <text class="badge-label">证据等级</text>
        <text class="badge-value ev-text-{{item.ev === 'A' ? 'a' : (item.ev === 'B' ? 'b' : 'c')}}">{{item.ev}}</text>
      </view>
      <view class="badge-box">
        <text class="badge-label">性价比</text>
        <text class="badge-value roi-text-{{item.roi === '极高' ? 'top' : (item.roi === '高' ? 'high' : 'mid')}}">{{item.roi}}</text>
      </view>
      </view>

      <!-- 这三个数字不是自明的，给个就近入口。
         放在这里而不是藏进胶囊，是因为用户正对着这几个字发懵。 -->
      <view class="marks-help" bindtap="onOpenHelp">
      <text>收益、证据等级、性价比是什么意思？</text>
      <text class="marks-help-arrow">›</text>
      </view>

    <view class="section" wx:if="{{item.text}}">
      <view class="sec-title"><text>说人话</text></view>
      <view class="sec-body"><text>{{item.text}}</text></view>
    </view>

    <view class="section" wx:if="{{item.costText}}">
      <view class="sec-title"><text>成本</text></view>
      <view class="sec-body"><text>{{item.costText}}</text></view>
    </view>

    <view class="section" wx:if="{{item.benefitText}}">
      <view class="sec-title"><text>完整收益与研究条件</text></view>
      <view class="sec-body"><text>{{item.benefitText}}</text></view>
    </view>

    <view class="section" wx:if="{{hasNotes}}">
      <view class="sec-title"><text>适用与限制 / 备注</text></view>
      <view class="sec-body"><text>{{item.notes}}</text></view>
    </view>

    <view class="section">
      <view class="sec-title"><text>人群条件</text></view>
      <view class="sec-body sec-muted"><text>{{audienceText}}</text></view>
    </view>

    <view class="section" wx:if="{{item.source}}">
      <view class="sec-title"><text>原始来源</text></view>
      <view class="sec-body sec-source"><text>{{item.source}}</text></view>
      <view class="sec-note"><text>证据等级 {{item.ev}}：{{evidenceDescText}}。等级与性价比相互独立。</text></view>
      <view wx:if="{{fixedSourceUrl}}" class="source-link">
        <text user-select="{{true}}">{{fixedSourceUrl}}</text>
      </view>
      <view wx:for="{{item.links}}" wx:key="*this" class="source-link">
        <text user-select="{{true}}">{{item}}</text>
      </view>
      <view class="sec-note"><text>长按链接可选中复制</text></view>
    </view>

    <view class="section">
      <view class="sec-title"><text>我的行动</text></view>
      <view class="actions">
        <view class="act {{fav ? 'act-on' : ''}}" bindtap="onToggleFav">
          <text>{{fav ? '★ 已收藏' : '☆ 收藏'}}</text>
        </view>
        <picker class="act-picker" range="{{actionOptions}}" bindchange="onPickAction">
          <view class="act act-primary">
            <text>{{actionLabel}} ▾</text>
          </view>
        </picker>
        <button class="act act-share" open-type="share" plain="true">
          <text>分享</text>
        </button>
      </view>
      <textarea
        class="note-input"
        value="{{note}}"
        maxlength="2000"
        placeholder="我的备注（可选，最多 2000 字）"
        bindinput="onNoteInput"
      />
      <view class="save-btn" bindtap="onSaveNote">
        <text>保存备注</text>
      </view>
    </view>

    <view class="footnote">
      <text>内容来自《高性价比人生指南》(HowToLiveBetter)，作者 eternity4719，CC BY 4.0。原文内容保留，政策和研究可能更新，请结合当地实际与专业建议。仅供参考，不构成医疗或投资建议。</text>
      <view class="doc-links">
        <text class="doc-link" data-type="terms" bindtap="onOpenAgreement">用户协议</text>
        <text class="doc-link-sep">·</text>
        <text class="doc-link" data-type="privacy" bindtap="onOpenAgreement">隐私政策</text>
      </view>
    </view>
  </view>
</scroll-view>
