page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fffdf6;
}

.page {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.pane {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.list {
  padding: 24rpx 28rpx 60rpx;
}

/* 顶部标签 */
.tabs {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #fffef8;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #e3e6db;
}

.tab {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 30rpx;
  font-size: 30rpx;
  color: #727b72;
  border-bottom: 6rpx solid transparent;
}

.tab-active {
  color: #214d3f;
  font-weight: 700;
  border-bottom-color: #214d3f;
}

.badge {
  margin-left: 10rpx;
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: #214d3f;
  color: #ffffff;
  font-size: 20rpx;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 指南库（筛选工具区） */
.library {
  margin-bottom: 24rpx;
  background: #fffef8;
  border: 1rpx solid #e3e6db;
  border-radius: 24rpx;
  padding: 26rpx 28rpx 24rpx;
}

.lib-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.lib-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #214d3f;
}

.lib-count {
  font-size: 23rpx;
  color: #a2aaa2;
}

/* 搜索与筛选切换 */
.search-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.search {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #e3e6db;
  border-radius: 16rpx;
  padding: 0 20rpx;
}

.filter-toggle {
  flex-shrink: 0;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 26rpx;
  background: #e7eddf;
  color: #214d3f;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.filter-toggle-on {
  background: #214d3f;
  color: #ffffff;
}

/* 高级筛选面板（默认折叠） */
.filter-panel {
  padding-top: 22rpx;
}

.search-icon {
  font-size: 24rpx;
  color: #94a094;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  height: 74rpx;
  font-size: 27rpx;
  color: #23302a;
}

.search-ph {
  color: #a2aaa2;
}

/* 收益口径 */
.outcome-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.outcome {
  flex: 1;
  min-width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #214d3f;
  border: 1rpx solid #dfe4d7;
  border-radius: 16rpx;
  font-size: 25rpx;
  padding: 14rpx 10rpx;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
}

.outcome-active {
  background: #214d3f;
  color: #ffffff;
  border-color: #214d3f;
}

/* picker 筛选 */
.filters {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.filter {
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.filter-pill {
  background: #e7eddf;
  color: #214d3f;
  border-radius: 10rpx;
  font-size: 23rpx;
  padding: 12rpx 18rpx;
  max-width: 320rpx;
  overflow: hidden;
}

/* 开关 */
.toggle {
  background: #ffffff;
  color: #214d3f;
  border: 1rpx solid #dfe4d7;
  border-radius: 999rpx;
  font-size: 23rpx;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.toggle-active {
  background: #214d3f;
  color: #ffffff;
  border-color: #214d3f;
}

.toggle-reset {
  color: #727b72;
}

.explanation {
  font-size: 22rpx;
  color: #727b72;
  line-height: 1.6;
  margin-top: 4rpx;
}

/* 空态与脚注 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #727b72;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 25rpx;
  color: #a2aaa2;
}

/* 模糊匹配提示 */
.fuzzy-hint {
  background: #faf0d9;
  color: #956e27;
  border-radius: 16rpx;
  font-size: 23rpx;
  line-height: 1.6;
  padding: 16rpx 22rpx;
  margin-bottom: 20rpx;
}

.empty-btn {
  margin-top: 28rpx;
  padding: 14rpx 44rpx;
  border-radius: 999rpx;
  background: #214d3f;
  color: #ffffff;
  font-size: 26rpx;
}

.footnote {
  text-align: center;
  font-size: 22rpx;
  color: #a2aaa2;
  padding: 20rpx 0;
}

.source-note {
  line-height: 1.6;
}

/* 协议链接 */
.doc-links {
  margin-top: 14rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.doc-link {
  color: #214d3f;
  font-size: 22rpx;
  padding: 6rpx 4rpx;
}

.doc-link-sep {
  color: #a2aaa2;
  font-size: 22rpx;
  margin: 0 12rpx;
}

/* 行动清单 */
.todo {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  background: #ffffff;
  border: 1rpx solid #e3e6db;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.todo-check {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  border: 3rpx solid #c9d1c6;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  flex-shrink: 0;
}

.todo-check-on {
  background: #214d3f;
  border-color: #214d3f;
}

.todo-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.todo-title {
  font-size: 29rpx;
  color: #23302a;
  line-height: 1.45;
}

.todo-tags {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 10rpx;
}

.status {
  font-size: 20rpx;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-right: 14rpx;
}

.st-ready {
  background: #eef3e8;
  color: #477347;
}

.st-doing {
  background: #faf0d9;
  color: #956e27;
}

.st-done {
  background: #e7eddf;
  color: #214d3f;
}

.st-na {
  background: #f2f4f7;
  color: #6b7480;
}

.todo-date {
  font-size: 22rpx;
  color: #a2aaa2;
}

.todo-note {
  font-size: 24rpx;
  color: #727b72;
  line-height: 1.6;
  margin-top: 10rpx;
}

.todo-done .todo-title {
  color: #a2aaa2;
  text-decoration: line-through;
}

.todo-del {
  margin-left: 20rpx;
  font-size: 23rpx;
  color: #b9c1b6;
  padding: 10rpx 14rpx;
  flex-shrink: 0;
}

/* 悬浮：回到筛选区 */
.fab-filter {
  position: absolute;
  right: 28rpx;
  bottom: 48rpx;
  background: #214d3f;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 18rpx 34rpx;
  box-shadow: 0 8rpx 24rpx rgba(33, 77, 63, 0.35);
}
