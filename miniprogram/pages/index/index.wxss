page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fffdf6;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

/* 落地页（独立成屏：主内容居中，次级入口沉底） */
.landing {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 1200rpx;
  padding: 70rpx 40rpx 60rpx;
}

.landing-main {
  display: flex;
  flex-direction: column;
}

.hero {
  display: flex;
  flex-direction: column;
}

.hero-eyebrow {
  font-size: 21rpx;
  letter-spacing: 6rpx;
  color: #44745b;
}

.hero-title {
  font-size: 62rpx;
  font-weight: 700;
  color: #214d3f;
  line-height: 1.35;
  letter-spacing: -1rpx;
  margin-top: 18rpx;
}

.hero-sub {
  font-size: 26rpx;
  color: #727b72;
  line-height: 1.7;
  margin-top: 24rpx;
}

.hero-stats {
  font-size: 23rpx;
  color: #727b72;
  margin-top: 18rpx;
}

/* 今日一条（可分享的原子单元） */
.daily {
  display: flex;
  flex-direction: column;
  background: #e7eddf;
  border-radius: 24rpx;
  padding: 34rpx;
  margin-top: 64rpx;
}

.quote-label {
  font-size: 22rpx;
  color: #44745b;
}

.daily-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.daily-refresh {
  font-size: 22rpx;
  color: #44745b;
  padding: 6rpx 14rpx;
}

.daily-title {
  font-size: 33rpx;
  font-weight: 650;
  color: #214d3f;
  line-height: 1.5;
  margin-top: 12rpx;
}

.daily-text {
  font-size: 25rpx;
  color: #4e5a4e;
  line-height: 1.7;
  margin-top: 14rpx;
}

.daily-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 18rpx;
}

.daily-badge {
  font-size: 21rpx;
  background: #faf0d9;
  color: #956e27;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-right: 16rpx;
}

/* 章节名长短差得远，加了性价比标记后更容易一行放不下。
   让它自己收缩并截断，别把两个标记顶出卡片。 */
.daily-ch {
  font-size: 22rpx;
  color: #44745b;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.daily-actions {
  display: flex;
  flex-direction: row;
  margin-top: 26rpx;
}

/* 主按钮实心，分享按钮描边弱化 */
.daily-btn {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 999rpx;
  background: #214d3f;
  color: #ffffff;
  font-size: 26rpx;
}

/* button open-type=share 是唯一等价于右上角「转发给朋友」的写法：
   官方规定必须是 button 组件，view 上加 open-type 无效。
   plain 用于去掉 button 自带的边框，否则会出现一圈去不掉的黑边。 */
button.daily-btn {
  margin: 0;
  padding: 0;
  line-height: normal;
  font-size: 26rpx;
  border-radius: 999rpx;
}

button.daily-btn::after {
  border: none;
}

/* 分享做成次要按钮（描边）。用「元素 + 类」显式写，不依赖 button[plain]
   属性选择器，原因有两个：
   1) Skyline 对 CSS 选择器的支持是子集，不保证支持属性选择器；
   2) 曾经这里写过 button[plain] { border: 0 }，它的特异性 (0,1,1) 高于
      单个类 (0,1,0)，把下面这行的 border 直接吃掉了，描边根本没出现。
   与 detail.wxss 的 .act-share 保持同一写法。 */
button.daily-btn-share {
  margin-left: 16rpx;
  background: transparent;
  color: #214d3f;
  border: 2rpx solid #214d3f;
  box-sizing: border-box;
}

.daily-foot {
  font-size: 22rpx;
  color: #727b72;
  margin-top: 22rpx;
}

/* 主 CTA（浅绿药丸，弱化突兀感；箭头滑动动画引导点击） */
.cta {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 56rpx;
  height: 100rpx;
  border-radius: 999rpx;
  background: #e7eddf;
  color: #214d3f;
  font-size: 30rpx;
  font-weight: 650;
  border: 2rpx solid #d3ddcb;
}

.cta-arrow {
  margin-left: 14rpx;
  font-size: 34rpx;
  animation: cta-slide 1.6s ease-in-out infinite;
}

@keyframes cta-slide {
  0% {
    transform: translateX(0);
  }
  50% {
    transform: translateX(14rpx);
  }
  100% {
    transform: translateX(0);
  }
}

/* 次级入口（沉底，白底描边弱化层级） */
.landing-foot {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 90rpx;
}

.entries {
  display: flex;
  flex-direction: row;
  justify-content: center;
}

.entry {
  background: #ffffff;
  border: 1rpx solid #dfe4d7;
  color: #727b72;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 16rpx 36rpx;
  margin: 0 12rpx;
}

/* 脚注 */
.footnote {
  text-align: center;
  font-size: 22rpx;
  color: #a2aaa2;
  padding: 20rpx 0;
}

.source-note {
  margin-top: 34rpx;
  line-height: 1.6;
}

/* 协议 / 隐私 / 反馈：紧跟主 CTA，避免沉到页面最底部 */
.doc-links {
  margin-top: 48rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
}

/* Skyline 下 button 不当普通 flex item 看待：width:auto 时按块级铺满整行，
   把同一行的文字挤到每行只剩三个字（「使用说／明」「用户协／议」）。
   所以这一行的所有项一律不伸缩、不折行，按钮给一个够放四个字的确切宽度。 */
.doc-link {
  flex: none;
  white-space: nowrap;
  color: #214d3f;
  font-size: 22rpx;
  /* 纵向内边距撑到 88rpx 的点击区。原来 6rpx 内边距只有约 35rpx 高，
     这几个协议链接本来就小，老人家点不中 */
  padding: 30rpx 10rpx;
}

.doc-link-sep {
  flex: none;
  white-space: nowrap;
  color: #a2aaa2;
  font-size: 22rpx;
  margin: 0 12rpx;
}

/* 官方意见反馈：button 要清掉默认样式、去掉 ::after 边框，
   并且必须给死宽度——四个字 22rpx 一共 88rpx，留点余量取 100rpx */
.doc-link-btn {
  flex: none;
  width: 100rpx;
  min-width: 0;
  box-sizing: border-box;
  white-space: nowrap;
  background: transparent;
  border: none;
  margin: 0;
  /* 与旁边的 .doc-link 保持同样的点击区高度 */
  padding: 30rpx 4rpx;
  line-height: 1.6;
  font-size: 22rpx;
  font-weight: normal;
  color: #214d3f;
}

.doc-link-btn::after {
  border: none;
}

/* ===== 等级配色 =====
   性价比 roi：暖色，越值得做越醒目（极高/高/一般）
   证据等级 ev：绿色，越可靠越深（A/B/C）
   标签用背景色区分，数值用字体色区分。 ===== */

/* 标签：背景色 */
.roi-top { background: #c05621; color: #ffffff; }
.roi-high { background: #c98a1b; color: #ffffff; }
.roi-mid { background: #e7eddf; color: #214d3f; }

.ev-a { background: #214d3f; color: #ffffff; }
.ev-b { background: #7d9670; color: #ffffff; }
.ev-c { background: #f1f4ec; color: #8a917d; }

/* 数值：字体色 —— 首页只用上面的背景色变体（roi-* / ev-*），
   这几个「只改字体色」的版本没有任何 wxml 引用，已删除。 */
