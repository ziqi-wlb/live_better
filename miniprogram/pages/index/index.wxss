page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fffdf6;
}

.page {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.pane {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.list {
  padding: 24rpx 28rpx 60rpx;
}

/* 顶部标签 */
.tabs {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #fffef8;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #e3e6db;
}

.tab {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 30rpx;
  font-size: 30rpx;
  color: #727b72;
  border-bottom: 6rpx solid transparent;
}

.tab-active {
  color: #214d3f;
  font-weight: 700;
  border-bottom-color: #214d3f;
}

.badge {
  margin-left: 10rpx;
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: #214d3f;
  color: #ffffff;
  font-size: 20rpx;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Hero 落地页与每日一句 */
.landing {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 960rpx;
  padding: 40rpx 8rpx 20rpx;
}

.hero {
  display: flex;
  flex-direction: column;
}

.hero-eyebrow {
  font-size: 21rpx;
  letter-spacing: 6rpx;
  color: #44745b;
}

.hero-title {
  font-size: 60rpx;
  font-weight: 700;
  color: #214d3f;
  line-height: 1.35;
  letter-spacing: -1rpx;
  margin-top: 16rpx;
}

.hero-sub {
  font-size: 26rpx;
  color: #727b72;
  line-height: 1.7;
  margin-top: 22rpx;
}

.hero-stats {
  font-size: 23rpx;
  color: #727b72;
  margin-top: 18rpx;
}

.quote {
  display: flex;
  flex-direction: column;
  background: #e7eddf;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 50rpx;
}

.quote-label {
  font-size: 22rpx;
  color: #44745b;
}

.quote-title {
  font-size: 33rpx;
  font-weight: 650;
  color: #214d3f;
  line-height: 1.5;
  margin-top: 12rpx;
}

.quote-text {
  font-size: 24rpx;
  color: #727b72;
  margin-top: 14rpx;
}

.scroll-hint {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin: 50rpx auto 0;
  font-size: 25rpx;
  color: #214d3f;
  background: #e7eddf;
  border-radius: 999rpx;
  padding: 20rpx 52rpx;
}

.scroll-hint-arrow {
  font-size: 28rpx;
  margin-right: 12rpx;
  animation: hint-bob 1.6s ease-in-out infinite;
}

@keyframes hint-bob {
  0% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(8rpx);
  }
  100% {
    transform: translateY(0);
  }
}

/* 指南库（筛选工具区） */
.library {
  margin: 30rpx -28rpx 0;
  background: #fffef8;
  border-top: 1rpx solid #e3e6db;
  padding: 26rpx 28rpx 24rpx;
}

.lib-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.lib-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #214d3f;
}

.lib-count {
  font-size: 23rpx;
  color: #a2aaa2;
}

/* 筛选控件 */
.search {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #e3e6db;
  border-radius: 16rpx;
  padding: 0 20rpx;
  margin-bottom: 18rpx;
}

.search-icon {
  font-size: 24rpx;
  color: #94a094;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  height: 74rpx;
  font-size: 27rpx;
  color: #23302a;
}

.search-ph {
  color: #a2aaa2;
}

/* 收益口径 */
.outcome-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.outcome {
  flex: 1;
  min-width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #214d3f;
  border: 1rpx solid #dfe4d7;
  border-radius: 16rpx;
  font-size: 25rpx;
  padding: 14rpx 10rpx;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
}

.outcome-active {
  background: #214d3f;
  color: #ffffff;
  border-color: #214d3f;
}

/* picker 筛选 */
.filters {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.filter {
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.filter-pill {
  background: #e7eddf;
  color: #214d3f;
  border-radius: 10rpx;
  font-size: 23rpx;
  padding: 12rpx 18rpx;
  max-width: 320rpx;
  overflow: hidden;
}

/* 开关 */
.toggle {
  background: #ffffff;
  color: #214d3f;
  border: 1rpx solid #dfe4d7;
  border-radius: 999rpx;
  font-size: 23rpx;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.toggle-active {
  background: #214d3f;
  color: #ffffff;
  border-color: #214d3f;
}

.toggle-reset {
  color: #727b72;
}

.explanation {
  font-size: 22rpx;
  color: #727b72;
  line-height: 1.6;
  margin-top: 4rpx;
}

/* 空态与脚注 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #727b72;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 25rpx;
  color: #a2aaa2;
}

.empty-btn {
  margin-top: 28rpx;
  padding: 14rpx 44rpx;
  border-radius: 999rpx;
  background: #214d3f;
  color: #ffffff;
  font-size: 26rpx;
}

.footnote {
  text-align: center;
  font-size: 22rpx;
  color: #a2aaa2;
  padding: 20rpx 0;
}

.source-note {
  line-height: 1.6;
}

/* 行动清单 */
.todo {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  background: #ffffff;
  border: 1rpx solid #e3e6db;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.todo-check {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  border: 3rpx solid #c9d1c6;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  flex-shrink: 0;
}

.todo-check-on {
  background: #214d3f;
  border-color: #214d3f;
}

.todo-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.todo-title {
  font-size: 29rpx;
  color: #23302a;
  line-height: 1.45;
}

.todo-tags {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 10rpx;
}

.status {
  font-size: 20rpx;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-right: 14rpx;
}

.st-准备做 {
  background: #eef3e8;
  color: #477347;
}

.st-进行中 {
  background: #faf0d9;
  color: #956e27;
}

.st-已完成 {
  background: #e7eddf;
  color: #214d3f;
}

.st-暂不适用 {
  background: #f2f4f7;
  color: #6b7480;
}

.todo-date {
  font-size: 22rpx;
  color: #a2aaa2;
}

.todo-note {
  font-size: 24rpx;
  color: #727b72;
  line-height: 1.6;
  margin-top: 10rpx;
}

.todo-done .todo-title {
  color: #a2aaa2;
  text-decoration: line-through;
}

.todo-del {
  margin-left: 20rpx;
  font-size: 23rpx;
  color: #b9c1b6;
  padding: 10rpx 14rpx;
  flex-shrink: 0;
}

/* 悬浮：回到筛选区 */
.fab-filter {
  position: absolute;
  right: 28rpx;
  bottom: 48rpx;
  background: #214d3f;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 18rpx 34rpx;
  box-shadow: 0 8rpx 24rpx rgba(33, 77, 63, 0.35);
}
