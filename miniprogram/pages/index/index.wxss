page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fffdf6;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

/* 落地页（独立成屏：主内容居中，次级入口沉底） */
.landing {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 1200rpx;
  padding: 70rpx 40rpx 60rpx;
}

.landing-main {
  display: flex;
  flex-direction: column;
}

.hero {
  display: flex;
  flex-direction: column;
}

.hero-eyebrow {
  font-size: 21rpx;
  letter-spacing: 6rpx;
  color: #44745b;
}

.hero-title {
  font-size: 62rpx;
  font-weight: 700;
  color: #214d3f;
  line-height: 1.35;
  letter-spacing: -1rpx;
  margin-top: 18rpx;
}

.hero-sub {
  font-size: 26rpx;
  color: #727b72;
  line-height: 1.7;
  margin-top: 24rpx;
}

.hero-stats {
  font-size: 23rpx;
  color: #727b72;
  margin-top: 18rpx;
}

/* 每日一句 */
.quote {
  display: flex;
  flex-direction: column;
  background: #e7eddf;
  border-radius: 24rpx;
  padding: 34rpx;
  margin-top: 64rpx;
}

.quote-label {
  font-size: 22rpx;
  color: #44745b;
}

.quote-title {
  font-size: 33rpx;
  font-weight: 650;
  color: #214d3f;
  line-height: 1.5;
  margin-top: 12rpx;
}

.quote-text {
  font-size: 24rpx;
  color: #727b72;
  margin-top: 14rpx;
}

/* 主 CTA（箭头滑动动画引导点击） */
.cta {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 60rpx;
  height: 104rpx;
  border-radius: 999rpx;
  background: #214d3f;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 650;
  box-shadow: 0 10rpx 30rpx rgba(33, 77, 63, 0.3);
}

.cta-arrow {
  margin-left: 14rpx;
  font-size: 34rpx;
  animation: cta-slide 1.6s ease-in-out infinite;
}

@keyframes cta-slide {
  0% {
    transform: translateX(0);
  }
  50% {
    transform: translateX(14rpx);
  }
  100% {
    transform: translateX(0);
  }
}

/* 次级入口（沉底） */
.landing-foot {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.entries {
  display: flex;
  flex-direction: row;
  justify-content: center;
}

.entry {
  background: #e7eddf;
  color: #214d3f;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 16rpx 36rpx;
  margin: 0 12rpx;
}

/* 脚注 */
.footnote {
  text-align: center;
  font-size: 22rpx;
  color: #a2aaa2;
  padding: 20rpx 0;
}

.source-note {
  margin-top: 34rpx;
  line-height: 1.6;
}

.doc-links {
  margin-top: 14rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.doc-link {
  color: #214d3f;
  font-size: 22rpx;
  padding: 6rpx 4rpx;
}

.doc-link-sep {
  color: #a2aaa2;
  font-size: 22rpx;
  margin: 0 12rpx;
}
