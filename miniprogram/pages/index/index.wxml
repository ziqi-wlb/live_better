<navigation-bar title="人生指南" back="{{false}}" color="black" background="#FFFDF6"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="landing">
    <view class="landing-main">
      <view class="hero">
        <text class="hero-eyebrow">A LITTLE BETTER, EVERY DAY</text>
        <text class="hero-title">把有限的精力，</text>
        <text class="hero-title">花在值得的地方。</text>
        <text class="hero-sub">有出处、能筛选、可行动。先查清楚，再选适合自己的那一件。</text>
        <text class="hero-stats">{{chapterCount}} 个章节 · {{totalGuides}} 条真实建议</text>
      </view>

      <view class="quote">
        <text class="quote-label">给今天的你</text>
        <text class="quote-title">不用全做。挑走一两条，就算数。</text>
        <text class="quote-text">从自己的生活开始，不必和别人比赛。</text>
      </view>

      <view class="cta" bindtap="onExplore">
        <text>开始探索指南</text>
        <text class="cta-arrow">→</text>
      </view>
    </view>

    <view class="landing-foot">
      <view class="entries">
        <view class="entry" data-tab="fav" bindtap="onOpenTab">
          <text>收藏{{favCount > 0 ? ' · ' + favCount : ''}}</text>
        </view>
        <view class="entry" data-tab="todo" bindtap="onOpenTab">
          <text>行动清单{{todoLeft > 0 ? ' · ' + todoLeft : ''}}</text>
        </view>
      </view>

      <view class="footnote source-note">
        <text>内容来自《高性价比人生指南》(HowToLiveBetter)，作者 eternity4719，CC BY 4.0</text>
        <view class="doc-links">
          <text class="doc-link" data-type="terms" bindtap="onOpenAgreement">用户协议</text>
          <text class="doc-link-sep">·</text>
          <text class="doc-link" data-type="privacy" bindtap="onOpenAgreement">隐私政策</text>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
