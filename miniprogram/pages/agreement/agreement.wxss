page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fffdf6;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.doc {
  padding: 24rpx 36rpx 60rpx;
}

.tabs {
  display: flex;
  flex-direction: row;
  background: #fffef8;
  border: 1rpx solid #e3e6db;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 32rpx;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #727b72;
  border-radius: 12rpx;
}

.tab-active {
  background: #e7eddf;
  color: #214d3f;
  font-weight: 700;
}

.sec {
  margin-bottom: 32rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #214d3f;
  margin-bottom: 12rpx;
}

.sec-p {
  font-size: 27rpx;
  line-height: 1.75;
  color: #3c463c;
  margin-bottom: 10rpx;
}

.footnote {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #9aa39a;
  text-align: center;
}
