<navigation-bar title="{{navTitle}}" back="{{true}}" color="black" background="#FFFDF6"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="doc">
    <view class="tabs">
      <view class="tab {{tab === 'terms' ? 'tab-active' : ''}}" data-tab="terms" bindtap="onSwitchTab">
        <text>用户协议</text>
      </view>
      <view class="tab {{tab === 'privacy' ? 'tab-active' : ''}}" data-tab="privacy" bindtap="onSwitchTab">
        <text>隐私政策</text>
      </view>
    </view>

    <view class="sec" wx:for="{{sections}}" wx:key="h">
      <view class="sec-title"><text>{{item.h}}</text></view>
      <view class="sec-p" wx:for="{{item.p}}" wx:for-item="para" wx:key="*this">
        <text>{{para}}</text>
      </view>
    </view>

    <view class="footnote"><text>本页内容最后更新：2026-10-15</text></view>
  </view>
</scroll-view>
