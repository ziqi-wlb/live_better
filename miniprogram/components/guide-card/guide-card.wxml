<view class="card" bindtap="onOpen">
  <view class="card-top">
    <view class="tags">
      <text class="tag tag-roi">{{item.roi}}</text>
      <text class="tag">证据 {{item.ev}}</text>
      <text wx:if="{{item.cv}}" class="tag tag-cv">争议</text>
      <text wx:if="{{item.nv}}" class="tag tag-nv">待核实</text>
    </view>
    <view class="star {{item.fav ? 'star-on' : ''}}" catchtap="onFav">
      <text>{{item.fav ? '★' : '☆'}}</text>
    </view>
  </view>
  <view class="card-title"><text>{{item.title}}</text></view>
  <view class="card-summary"><text>{{item.summary}}</text></view>
  <view class="cost">
    <text>钱：{{item.money || '未标注'}}　时间：{{item.time || '未标注'}}　毅力：{{item.effort || '未标注'}}</text>
  </view>
  <view class="card-footer">
    <text class="muted">第 {{item.ch}} 节 · 第 {{item.no}} 条</text>
    <view class="add-btn" catchtap="onAdd"><text>+ 清单</text></view>
  </view>
</view>
