<view class="card" bindtap="onOpen">
  <view class="card-top">
    <view class="tags">
      <text class="tag tag-roi {{item.roi === '极高' ? 'roi-top' : (item.roi === '高' ? 'roi-high' : 'roi-mid')}}">{{item.roi}}</text>
      <text class="tag tag-ev {{item.ev === 'A' ? 'ev-a' : (item.ev === 'B' ? 'ev-b' : 'ev-c')}}">证据 {{item.ev}}</text>
      <text wx:if="{{item.cv}}" class="tag tag-cv">争议</text>
      <text wx:if="{{item.nv}}" class="tag tag-nv">待核实</text>
    </view>
    <view class="star {{item.fav ? 'star-on' : ''}}" catchtap="onFav">
      <text>{{item.fav ? '★' : '☆'}}</text>
    </view>
  </view>
  <view class="card-title">
    <block wx:if="{{item.titleSegs}}">
      <text wx:for="{{item.titleSegs}}" wx:for-item="seg" class="{{seg.h ? 'hit' : ''}}">{{seg.t}}</text>
    </block>
    <text wx:else>{{item.title}}</text>
  </view>
  <view class="card-summary">
    <block wx:if="{{item.summarySegs}}">
      <text wx:for="{{item.summarySegs}}" wx:for-item="seg" class="{{seg.h ? 'hit' : ''}}">{{seg.t}}</text>
    </block>
    <text wx:else>{{item.summary}}</text>
  </view>
  <view class="cost">
    <text>钱：{{item.money || '未标注'}}　时间：{{item.time || '未标注'}}　毅力：{{item.effort || '未标注'}}</text>
  </view>
  <view class="card-footer">
    <text class="muted">第 {{item.ch}} 节 · 第 {{item.no}} 条</text>
    <view class="add-btn" catchtap="onAdd"><text>+ 清单</text></view>
  </view>
</view>
