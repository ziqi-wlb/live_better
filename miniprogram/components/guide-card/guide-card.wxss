.card {
  background: #ffffff;
  border: 1rpx solid #e3e6db;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.card-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.tag {
  background: #eef3e8;
  color: #477347;
  border-radius: 8rpx;
  font-size: 21rpx;
  padding: 5rpx 14rpx;
  margin-right: 10rpx;
  margin-bottom: 6rpx;
}

.tag-roi {
  background: #e7eddf;
  color: #214d3f;
  font-weight: 600;
}

.tag-ev {
  background: #faf0d9;
  color: #956e27;
}

.tag-cv {
  background: #fdeaea;
  color: #d43a3f;
}

.tag-nv {
  background: #fdf1dd;
  color: #b06e00;
}

.star {
  padding: 4rpx 12rpx;
  font-size: 24rpx;
  color: #b9c1b6;
}

.star-on {
  color: #c98a1b;
}

.card-title {
  font-size: 32rpx;
  font-weight: 650;
  color: #23302a;
  line-height: 1.45;
  margin-bottom: 12rpx;
}

.card-summary {
  font-size: 26rpx;
  color: #6e776e;
  line-height: 1.65;
  margin-bottom: 20rpx;
}

/* 搜索命中高亮 */
.hit {
  color: #956e27;
  background: #faf0d9;
  border-radius: 4rpx;
  font-weight: 600;
}

.cost {
  border-top: 1rpx solid #eef1e9;
  padding-top: 18rpx;
  font-size: 24rpx;
  color: #727b72;
}

.card-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.muted {
  font-size: 22rpx;
  color: #a2aaa2;
}

.add-btn {
  font-size: 24rpx;
  color: #214d3f;
  background: #e7eddf;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
}

/* ===== 等级配色 =====
   性价比 roi：暖色，越值得做越醒目（极高/高/一般）
   证据等级 ev：绿色，越可靠越深（A/B/C）
   标签用背景色区分，数值用字体色区分。 ===== */

/* 标签：背景色 */
.roi-top { background: #c05621; color: #ffffff; }
.roi-high { background: #c98a1b; color: #ffffff; }
.roi-mid { background: #e7eddf; color: #214d3f; }

.ev-a { background: #214d3f; color: #ffffff; }
.ev-b { background: #7d9670; color: #ffffff; }
.ev-c { background: #f1f4ec; color: #8a917d; }

/* 数值：字体色 */
.roi-text-top { color: #c05621; }
.roi-text-high { color: #c98a1b; }
.roi-text-mid { color: #8a917d; }

.ev-text-a { color: #214d3f; }
.ev-text-b { color: #7d9670; }
.ev-text-c { color: #9aa08f; }
