.card {
  background: #ffffff;
  border: 1rpx solid #e3e6db;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.card-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.tag {
  background: #eef3e8;
  color: #477347;
  border-radius: 8rpx;
  font-size: 21rpx;
  padding: 5rpx 14rpx;
  margin-right: 10rpx;
  margin-bottom: 6rpx;
}

.tag-roi {
  background: #e7eddf;
  color: #214d3f;
  font-weight: 600;
}

.tag-ev {
  background: #faf0d9;
  color: #956e27;
}

.tag-cv {
  background: #fdeaea;
  color: #d43a3f;
}

.tag-nv {
  background: #fdf1dd;
  color: #b06e00;
}

/* 收藏星：点击区放大到 88rpx。原来只有约 37rpx（4rpx 内边距 + 24rpx 字），
   老人家根本点不中。代价是卡片头部高约 47rpx。
   没有用负 margin 抵消这个撑高——那样放大的区域会压住下面标题的右边缘，
   想看正文却误触收藏。宁可让卡片高一点。 */
.star {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 抵掉原来 12rpx 右内边距带来的偏移，星号的视觉位置不变 */
  margin-right: -20rpx;
  font-size: 24rpx;
  color: #b9c1b6;
}

.star-on {
  color: #c98a1b;
}

.card-title {
  font-size: 32rpx;
  font-weight: 650;
  color: #23302a;
  line-height: 1.45;
  margin-bottom: 12rpx;
}

.card-summary {
  font-size: 26rpx;
  color: #6e776e;
  line-height: 1.65;
  margin-bottom: 20rpx;
}

/* 搜索命中高亮 */
.hit {
  color: #956e27;
  background: #faf0d9;
  border-radius: 4rpx;
  font-weight: 600;
}

.cost {
  border-top: 1rpx solid #eef1e9;
  padding-top: 18rpx;
  font-size: 24rpx;
  color: #727b72;
}

.card-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.muted {
  font-size: 22rpx;
  color: #a2aaa2;
}

/* 「+ 清单」原来约 49rpx 高，撑到 88rpx。
   代价：每张卡片因此高约 76rpx（收藏星 46 + 这里 30）。
   实测整卡从 344rpx 到 420rpx，一屏大约少看一条——
   换来的是两个最常用的按钮都点得中，对这个 App 的读者更值。 */
.add-btn {
  font-size: 24rpx;
  color: #214d3f;
  background: #e7eddf;
  border-radius: 999rpx;
  padding: 27rpx 26rpx;
}

/* ===== 等级配色 =====
   性价比 roi：暖色，越值得做越醒目（极高/高/一般）
   证据等级 ev：绿色，越可靠越深（A/B/C）
   标签用背景色区分，数值用字体色区分。 ===== */

/* 标签：背景色 */
.roi-top { background: #c05621; color: #ffffff; }
.roi-high { background: #c98a1b; color: #ffffff; }
.roi-mid { background: #e7eddf; color: #214d3f; }

.ev-a { background: #214d3f; color: #ffffff; }
.ev-b { background: #7d9670; color: #ffffff; }
.ev-c { background: #f1f4ec; color: #8a917d; }

/* 数值：字体色 —— 卡片只用上面的背景色变体（roi-* / ev-*），
   这几个「只改字体色」的版本没有任何 wxml 引用，已删除。 */
