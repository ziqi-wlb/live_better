.card {
  background: #ffffff;
  border: 1rpx solid #e3e6db;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.card-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.tag {
  background: #eef3e8;
  color: #477347;
  border-radius: 8rpx;
  font-size: 21rpx;
  padding: 5rpx 14rpx;
  margin-right: 10rpx;
  margin-bottom: 6rpx;
}

.tag-roi {
  background: #e7eddf;
  color: #214d3f;
  font-weight: 600;
}

.tag-ev {
  background: #faf0d9;
  color: #956e27;
}

.tag-cv {
  background: #fdeaea;
  color: #d43a3f;
}

.tag-nv {
  background: #fdf1dd;
  color: #b06e00;
}

.star {
  padding: 4rpx 12rpx;
  font-size: 24rpx;
  color: #b9c1b6;
}

.star-on {
  color: #c98a1b;
}

.card-title {
  font-size: 32rpx;
  font-weight: 650;
  color: #23302a;
  line-height: 1.45;
  margin-bottom: 12rpx;
}

.card-summary {
  font-size: 26rpx;
  color: #6e776e;
  line-height: 1.65;
  margin-bottom: 20rpx;
}

.cost {
  border-top: 1rpx solid #eef1e9;
  padding-top: 18rpx;
  font-size: 24rpx;
  color: #727b72;
}

.card-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.muted {
  font-size: 22rpx;
  color: #a2aaa2;
}

.add-btn {
  font-size: 24rpx;
  color: #214d3f;
  background: #e7eddf;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
}
